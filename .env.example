# Copier ce fichier en .env (non versionné) puis l'adapter.

# Fichier JSON utilisé par l'API : on passe du fichier de test au fichier
# réel sans modifier le code.
#  - préproduction : fichier de test versionné (admin, utilisateurs, films...)
VIDEOTHEQUE_FICHIER=/app/donnees/videotheque_test.json
#  - production : volume Docker, fichier créé vide au premier démarrage,
#    puis premier administrateur créé avec creer_admin.py
# VIDEOTHEQUE_FICHIER=/donnees/videotheque.json

# Clé TMDB pour l'import des films : clé d'API (v3) ou jeton d'accès en
# lecture (v4), sur https://www.themoviedb.org/settings/api
TMDB_CLE=
